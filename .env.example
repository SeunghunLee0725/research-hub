# Copy to .env on the hub machine. Never commit the real file.
HUB_PG_PASSWORD=change-me
HUB_PG_PORT=5440
HUB_DATABASE_URL=postgresql+psycopg://research_hub:change-me@127.0.0.1:5440/research_hub
# python -c "import secrets; print(secrets.token_urlsafe(48))"
HUB_SESSION_SECRET=
# uv run python -m hub.cli hash-password
HUB_ADMIN_PASSWORD_HASH=
# Bind to the Tailscale address only. Never 0.0.0.0.
HUB_BIND_HOST=100.x.y.z
HUB_PORT=8020
# Link base used in Telegram messages
HUB_PUBLIC_URL=http://100.x.y.z:8020
HUB_TELEGRAM_BOT_TOKEN=
HUB_TELEGRAM_CHAT_ID=
HUB_TELEGRAM_TOPIC_ID=
